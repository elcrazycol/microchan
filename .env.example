# Строка подключения к PostgreSQL (переопределяет database.url из конфига).
# Обычно не нужна: задайте database.url в config.toml. Если задать DATABASE_URL
# здесь, SQLx будет проверять запросы по живой БД на этапе сборки.
#DATABASE_URL=postgres://YOUR_USERNAME@localhost/microchan

# Секрет для HMAC-хэширования IP (переопределяет security.secret из конфига)
#MICROCHAN_SECRET=change-me

# Путь к конфигу (по умолчанию config.toml)
#MICROCHAN_CONFIG=config.toml

# Уровень логирования
#RUST_LOG=info,microchan=debug
