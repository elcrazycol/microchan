# PostgreSQL connection string (overrides database.url from config).
# Usually not needed: set database.url in config.toml instead. If set here,
# SQLx will validate queries against a live database at build time.
#DATABASE_URL=postgres://YOUR_USERNAME@localhost/microchan

# HMAC secret for IP hashing (overrides security.secret from config)
#MICROCHAN_SECRET=change-me

# Config path (default: config.toml)
#MICROCHAN_CONFIG=config.toml

# Log level
#RUST_LOG=info,microchan=debug
